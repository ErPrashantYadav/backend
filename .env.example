NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/liquor_shop?schema=public
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info
TRUST_PROXY_HOPS=1
REQUEST_BODY_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
AUTH_LOGIN_RATE_LIMIT_WINDOW_MS=900000
AUTH_LOGIN_RATE_LIMIT_MAX_REQUESTS=5
JWT_SECRET=<generate-32-random-bytes-and-base64url-encode>
JWT_ISSUER=https://api.example.invalid
JWT_AUDIENCE=liquor-shop-admin-api
JWT_ACCESS_TOKEN_TTL_SECONDS=900
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_PRODUCT_FOLDER=liquor_shop/products
CLOUDINARY_PAYMENT_QR_FOLDER=liquor_shop/payment_qr
CLOUDINARY_BANNER_FOLDER=liquor_shop/banners
CLOUDINARY_GALLERY_FOLDER=liquor_shop/gallery

# Google Maps and Delivery Routing Configuration
# GOOGLE_MAPS_API_KEY is optional in development/test, required for live Google Maps distance calculation
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
# Kathmandu store coordinates (latitude, longitude)
STORE_ORIGIN_LATITUDE=27.7172
STORE_ORIGIN_LONGITUDE=85.3240
# Delivery fee calculation mode: FIXED, PER_KM, or TIERED
DELIVERY_FEE_MODE=PER_KM
# Base delivery fee in NPR
DELIVERY_FEE_BASE_AMOUNT=100
# Incremental rate per road kilometer in NPR
DELIVERY_FEE_PER_KM_AMOUNT=25
# Optional free delivery threshold (subtotal in NPR). Leave unset to disable.
DELIVERY_FEE_FREE_THRESHOLD=5000
# Maximum delivery radius in kilometers from store origin
DELIVERY_MAX_DISTANCE_KM=25
# Fallback flat fee when coordinates are omitted and distance-based fee is unavailable
DELIVERY_FALLBACK_AMOUNT=0

# Notifications Configuration (Email & WhatsApp Outbox)
# WhatsApp Business API configuration for owner alerts on order creation
STORE_OWNER_WHATSAPP_NUMBER=+9779801234567
WHATSAPP_API_TOKEN=your_whatsapp_cloud_api_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id

# Customer Email Notifications (CONFIRMED, OUT_FOR_DELIVERY, DELIVERED, CANCELLED)
EMAIL_PROVIDER=CONSOLE
EMAIL_FROM=Old Liquor <orders@oldliquor.com>
# Store/admin email notification recipients (separate from sender EMAIL_FROM)
STORE_ORDER_NOTIFICATION_EMAIL=admin@oldliquor.com
STORE_CONTACT_NOTIFICATION_EMAIL=contact@oldliquor.com
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@your-domain.mailgun.org
SMTP_PASSWORD=your_smtp_password
RESEND_API_KEY=re_your_resend_api_key

# Outbox Worker Tuning
NOTIFICATION_WORKER_BATCH_SIZE=10
NOTIFICATION_MAX_ATTEMPTS=5