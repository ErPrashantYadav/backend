generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum InventoryMovementType {
  RESTOCK
  CORRECTION
  DAMAGE
  RETURN
  SALE
  INTERNAL_TRANSFER
  MANUAL_ADJUSTMENT
  OTHER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentMethodType {
  COD
  STATIC_QR
}

enum PaymentStatus {
  PENDING
  UNDER_REVIEW
  PAID
  FAILED
  REFUNDED
}

enum PaymentSubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationChannel {
  EMAIL
  WHATSAPP
}

enum NotificationStatus {
  PENDING
  PROCESSING
  DELIVERED
  FAILED
}

model AdminUser {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique @db.VarChar(254)
  name         String    @db.VarChar(120)
  passwordHash String    @db.VarChar(255)
  roleId       String    @db.Uuid
  isActive     Boolean
  lastLoginAt  DateTime? @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)

  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  inventoryMovements         InventoryMovement[]
  paymentSubmissionsReviewed PaymentSubmission[]
  orderStatusChanges         OrderStatusHistory[]
  auditLogs                  AuditLog[]

  @@index([roleId, isActive])
  @@index([isActive, createdAt])
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(80)
  description String?  @db.VarChar(500)
  isSystem    Boolean  @default(false)
  isActive    Boolean
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  adminUsers      AdminUser[]
  rolePermissions RolePermission[]

  @@index([isActive, name])
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @db.VarChar(120)
  description String?  @db.VarChar(500)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  rolePermissions RolePermission[]
}

model RolePermission {
  roleId       String   @db.Uuid
  permissionId String   @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model Category {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(120)
  slug         String   @unique @db.VarChar(160)
  description  String?  @db.Text
  imageUrl     String?  @db.VarChar(2048)
  displayOrder Int      @default(0)
  isActive     Boolean
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  products Product[]

  @@index([isActive, name])
  @@index([isActive, displayOrder])
}

model Brand {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(120)
  slug         String   @unique @db.VarChar(160)
  logoUrl      String?  @db.VarChar(2048)
  displayOrder Int      @default(0)
  isActive     Boolean
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  products Product[]

  @@index([isActive, name])
  @@index([isActive, displayOrder])
}


model Product {
  id            String        @id @default(uuid()) @db.Uuid
  categoryId    String        @db.Uuid
  brandId       String        @db.Uuid
  name          String        @db.VarChar(180)
  slug          String        @unique @db.VarChar(220)
  description   String?       @db.Text
  discountType  DiscountType?
  discountValue Decimal?      @db.Decimal(12, 2)
  isActive      Boolean
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(3)

  category Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  brand    Brand            @relation(fields: [brandId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  images   ProductImage[]
  variants ProductVariant[]

  @@index([categoryId, isActive])
  @@index([brandId, isActive])
  @@index([isActive, createdAt])
}

model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  imageUrl  String   @db.VarChar(2048)
  publicId  String?  @db.VarChar(255)
  altText   String?  @db.VarChar(255)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([productId, sortOrder])
}

model ProductVariant {
  id                String   @id @default(uuid()) @db.Uuid
  productId         String   @db.Uuid
  sku               String   @unique @db.VarChar(80)
  sizeLabel         String   @db.VarChar(50)
  sizeMilliliters   Int
  purchasePrice     Decimal  @db.Decimal(12, 2)
  sellingPrice      Decimal  @db.Decimal(12, 2)
  stock             Int      @default(0)
  lowStockThreshold Int
  isActive          Boolean
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  inventoryMovements InventoryMovement[]
  cartItems          CartItem[]
  orderItems         OrderItem[]

  @@unique([productId, sizeMilliliters])
  @@index([productId, isActive])
  @@index([stock])
}

model InventoryMovement {
  id            String                @id @default(uuid()) @db.Uuid
  variantId     String                @db.Uuid
  quantityDelta Int
  stockBefore   Int
  stockAfter    Int
  type          InventoryMovementType
  reason        String                @db.VarChar(500)
  actorAdminId  String?               @db.Uuid
  createdAt     DateTime              @default(now()) @db.Timestamptz(3)

  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  actorAdmin AdminUser?     @relation(fields: [actorAdminId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([variantId, createdAt])
  @@index([createdAt])
  @@index([actorAdminId])
}

model Customer {
  id              String   @id @default(uuid()) @db.Uuid
  name            String   @db.VarChar(180)
  phone           String   @db.VarChar(32)
  deliveryAddress String   @db.VarChar(500)
  email           String?  @db.VarChar(254)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  orders Order[]

  @@index([phone])
  @@index([email])
  @@index([createdAt])
}

model Cart {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique @db.VarChar(128)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  items CartItem[]
}

model CartItem {
  id        String   @id @default(uuid()) @db.Uuid
  cartId    String   @db.Uuid
  variantId String   @db.Uuid
  quantity  Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([cartId, variantId])
  @@index([variantId])
}

model Order {
  id                String      @id @default(uuid()) @db.Uuid
  orderNumber       String      @unique @db.VarChar(64)
  customerId        String?     @db.Uuid
  customerName      String      @db.VarChar(180)
  customerPhone     String      @db.VarChar(32)
  customerEmail     String?     @db.VarChar(254)
  deliveryAddress   String      @db.VarChar(500)
  deliveryLatitude  Decimal?    @db.Decimal(10, 7)
  deliveryLongitude Decimal?    @db.Decimal(10, 7)
  status            OrderStatus @default(PENDING)
  subtotal           Decimal     @db.Decimal(12, 2)
  discountTotal      Decimal     @default(0) @db.Decimal(12, 2)
  deliveryFee        Decimal       @default(0) @db.Decimal(12, 2)
  total              Decimal       @db.Decimal(12, 2)
  lookupTokenHash    String        @db.VarChar(64)
  idempotencyKey     String?       @unique @db.VarChar(128)
  requestFingerprint String?       @db.VarChar(64)
  paymentMethodCode  String?       @db.VarChar(50)
  paymentMethodName  String?       @db.VarChar(120)
  paymentStatus      PaymentStatus @default(PENDING)
  paymentReference   String?       @db.VarChar(255)
  promoCode          String?       @db.VarChar(50)
  promoDiscount      Decimal       @default(0) @db.Decimal(12, 2)
  promoCodeId        String?       @db.Uuid
  createdAt          DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime      @updatedAt @db.Timestamptz(3)

  customer           Customer?             @relation(fields: [customerId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  promoCodeRef       PromoCode?            @relation(fields: [promoCodeId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  items              OrderItem[]
  paymentSubmissions PaymentSubmission[]
  statusHistory      OrderStatusHistory[]
  notifications      NotificationOutbox[]
  promoRedemptions   PromoCodeRedemption[]

  @@index([customerId])
  @@index([createdAt])
  @@index([status])
  @@index([paymentStatus])
  @@index([lookupTokenHash])
  @@index([promoCode])
}

model PaymentMethod {
  id            String            @id @default(uuid()) @db.Uuid
  code          String            @unique @db.VarChar(50)
  type          PaymentMethodType
  name          String            @db.VarChar(120)
  description   String?           @db.Text
  providerLabel String?           @db.VarChar(120)
  accountName   String?           @db.VarChar(180)
  accountNumber String?           @db.VarChar(100)
  qrImageUrl    String?           @db.VarChar(2048)
  instructions  String?           @db.Text
  minAmount     Decimal?          @db.Decimal(12, 2)
  maxAmount     Decimal?          @db.Decimal(12, 2)
  displayOrder  Int               @default(0)
  isActive      Boolean           @default(true)
  createdAt     DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @db.Timestamptz(3)

  @@index([isActive, displayOrder])
}

model OrderItem {
  id                 String   @id @default(uuid()) @db.Uuid
  orderId            String   @db.Uuid
  variantId          String   @db.Uuid
  productName        String   @db.VarChar(180)
  sku                String   @db.VarChar(80)
  sizeLabel          String   @db.VarChar(50)
  unitPrice          Decimal  @db.Decimal(12, 2)
  unitDiscount       Decimal  @default(0) @db.Decimal(12, 2)
  effectiveUnitPrice Decimal  @db.Decimal(12, 2)
  quantity           Int
  subtotal           Decimal  @db.Decimal(12, 2)
  createdAt          DateTime @default(now()) @db.Timestamptz(3)

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([orderId])
  @@index([variantId])
}

model PaymentSubmission {
  id                   String                  @id @default(uuid()) @db.Uuid
  orderId              String                  @db.Uuid
  proofImageUrl        String                  @db.VarChar(2048)
  transactionReference String?                 @db.VarChar(255)
  customerNotes        String?                 @db.Text
  status               PaymentSubmissionStatus @default(PENDING)
  reviewedByAdminId    String?                 @db.Uuid
  reviewedAt           DateTime?               @db.Timestamptz(3)
  rejectionReason      String?                 @db.Text
  createdAt            DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime                @updatedAt @db.Timestamptz(3)

  order           Order      @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  reviewedByAdmin AdminUser? @relation(fields: [reviewedByAdminId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([orderId])
  @@index([status])
  @@index([createdAt])
  @@index([reviewedByAdminId])
}

model OrderStatusHistory {
  id           String      @id @default(uuid()) @db.Uuid
  orderId      String      @db.Uuid
  fromStatus   OrderStatus
  toStatus     OrderStatus
  reason       String?     @db.VarChar(500)
  actorAdminId String?     @db.Uuid
  createdAt    DateTime    @default(now()) @db.Timestamptz(3)

  order      Order      @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  actorAdmin AdminUser? @relation(fields: [actorAdminId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([orderId, createdAt])
  @@index([actorAdminId])
  @@index([createdAt])
}

model AuditLog {
  id           String    @id @default(uuid()) @db.Uuid
  action       String    @db.VarChar(120)
  resourceType String    @db.VarChar(80)
  resourceId   String    @db.VarChar(120)
  actorAdminId String?   @db.Uuid
  metadata     Json?
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)

  actorAdmin AdminUser? @relation(fields: [actorAdminId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([action])
  @@index([resourceType, resourceId])
  @@index([actorAdminId])
  @@index([createdAt])
}

model NotificationOutbox {
  id             String              @id @default(uuid()) @db.Uuid
  channel        NotificationChannel
  eventType      String              @db.VarChar(80)
  recipient      String              @db.VarChar(254)
  subject        String?             @db.VarChar(255)
  payload        Json
  status         NotificationStatus  @default(PENDING)
  attemptCount   Int                 @default(0)
  maxAttempts    Int                 @default(5)
  nextRetryAt    DateTime            @default(now()) @db.Timestamptz(3)
  lastAttemptAt  DateTime?           @db.Timestamptz(3)
  processedAt    DateTime?           @db.Timestamptz(3)
  errorMessage   String?             @db.Text
  idempotencyKey String              @unique @db.VarChar(160)
  orderId        String?             @db.Uuid
  createdAt      DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @db.Timestamptz(3)

  order          Order?              @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([status, nextRetryAt])
  @@index([orderId])
  @@index([channel, status])
  @@index([createdAt])
}

model PromoCode {
  id                 String                @id @default(uuid()) @db.Uuid
  code               String                @unique @db.VarChar(50)
  description        String?               @db.VarChar(255)
  discountType       DiscountType
  discountValue      Decimal               @db.Decimal(12, 2)
  minimumOrderAmount Decimal?              @db.Decimal(12, 2)
  maxDiscountAmount  Decimal?              @db.Decimal(12, 2)
  startDate          DateTime?             @db.Timestamptz(3)
  endDate            DateTime?             @db.Timestamptz(3)
  usageLimit         Int?
  usedCount          Int                   @default(0)
  isActive           Boolean               @default(true)
  createdAt          DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime              @updatedAt @db.Timestamptz(3)

  orders             Order[]
  redemptions        PromoCodeRedemption[]

  @@index([code])
  @@index([isActive])
  @@index([startDate, endDate])
}

model PromoCodeRedemption {
  id             String    @id @default(uuid()) @db.Uuid
  promoCodeId    String    @db.Uuid
  orderId        String    @db.Uuid
  discountAmount Decimal   @db.Decimal(12, 2)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)

  promoCode      PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([promoCodeId, orderId])
  @@index([promoCodeId])
  @@index([orderId])
  @@index([createdAt])
}

enum ContactInquiryStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model ContactInquiry {
  id         String               @id @default(uuid()) @db.Uuid
  name       String               @db.VarChar(180)
  phone      String               @db.VarChar(32)
  email      String?              @db.VarChar(254)
  subject    String               @db.VarChar(200)
  message    String               @db.Text
  status     ContactInquiryStatus @default(NEW)
  adminNote  String?              @db.Text
  resolvedAt DateTime?            @db.Timestamptz(3)
  createdAt  DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime             @updatedAt @db.Timestamptz(3)

  @@index([status])
  @@index([createdAt])
  @@index([phone])
  @@index([email])
}

model Banner {
  id           String    @id @default(uuid()) @db.Uuid
  title        String    @db.VarChar(180)
  description  String?   @db.Text
  imageUrl     String    @db.VarChar(2048)
  publicId     String?   @db.VarChar(255)
  linkUrl      String?   @db.VarChar(2048)
  displayOrder Int       @default(0)
  isActive     Boolean   @default(true)
  startDate    DateTime? @db.Timestamptz(3)
  endDate      DateTime? @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)

  @@index([isActive, displayOrder])
  @@index([startDate, endDate])
  @@index([createdAt])
}

model GalleryItem {
  id           String   @id @default(uuid()) @db.Uuid
  title        String   @db.VarChar(180)
  description  String?  @db.Text
  imageUrl     String   @db.VarChar(2048)
  publicId     String?  @db.VarChar(255)
  category     String?  @db.VarChar(100)
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  @@index([isActive, displayOrder])
  @@index([category])
  @@index([createdAt])
}

model StoreSettings {
  id                    String    @id @default("default") @db.VarChar(50)
  storeName             String    @default("Old Liquor") @db.VarChar(180)
  storeTagline          String?   @db.VarChar(255)
  primaryPhone          String    @default("+977-9801234567") @db.VarChar(50)
  secondaryPhone        String?   @db.VarChar(50)
  supportEmail          String    @default("support@oldliquor.com") @db.VarChar(255)
  address               String    @default("Kathmandu, Nepal") @db.VarChar(255)
  city                  String    @default("Kathmandu") @db.VarChar(100)
  locationUrl           String?   @db.VarChar(2048)
  socialLinks           Json?     @db.JsonB
  businessHours         Json      @db.JsonB
  announcementText      String?   @db.Text
  announcementActive    Boolean   @default(false)
  announcementStartDate DateTime? @db.Timestamptz(3)
  announcementEndDate   DateTime? @db.Timestamptz(3)
  timezone              String    @default("Asia/Kathmandu") @db.VarChar(50)
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)
}

model SocialMedia {
  id           String   @id @default(uuid()) @db.Uuid
  platform     String   @db.VarChar(50)
  url          String   @db.VarChar(2048)
  type         String   @default("video") @db.VarChar(20)
  label        String?  @db.VarChar(180)
  thumbnailUrl String?  @db.VarChar(2048)
  publicId     String?  @db.VarChar(255)
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  @@index([platform])
  @@index([type, isActive])
  @@index([isActive, displayOrder])
  @@index([createdAt])
}



