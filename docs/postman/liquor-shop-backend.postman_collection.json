            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer\": {\n    \"name\": \"Prakash Sharma\",\n    \"phone\": \"+977-9841234567\",\n    \"deliveryAddress\": \"House 12, Thamel, Kathmandu\",\n    \"email\": \"prakash@example.test\"\n  },\n  \"paymentMethodCode\": \"CASH_ON_DELIVERY\"\n}"
            },
