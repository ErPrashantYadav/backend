    {
      "name": "13. Banners (With Reordering)",
      "item": [
        {
          "name": "Public List Banners (GET /api/banners)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/banners",
              "host": ["{{baseUrl}}"],
              "path": ["api", "banners"]
            }
          }
        },
        {
          "name": "Admin Create Banner (POST /api/admin/banners)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Weekend Spirits Sale\",\n  \"imageUrl\": \"https://res.cloudinary.com/demo/image/upload/banner_sample.jpg\",\n  \"linkUrl\": \"https://oldliquor.com/promo\",\n  \"isActive\": true,\n  \"displayOrder\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/banners",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "banners"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "var json = pm.response.json();",
                  "if (json.data && json.data.id) pm.environment.set(\"bannerId\", json.data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Admin Reorder Banners (PUT /api/admin/banners/reorder)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"id\": \"{{bannerId}}\",\n      \"displayOrder\": 0\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/banners/reorder",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "banners", "reorder"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Banner reordering succeeds\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
